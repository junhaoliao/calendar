{
    "name": "@junhaoliao/calendar",
    "version": "0.1.0",
    "private": true,
    "description": "Controlled React event calendar with four views, accessible dragging and responsive overlap lanes.",
    "license": "MIT",
    "author": "Junhao Liao <junhao@junhao.ca>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/junhaoliao/calendar.git"
    },
    "homepage": "https://github.com/junhaoliao/calendar#readme",
    "bugs": {
        "url": "https://github.com/junhaoliao/calendar/issues"
    },
    "keywords": [
        "react",
        "calendar",
        "event-calendar",
        "scheduler",
        "drag-and-drop"
    ],
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "engines": {
        "node": ">=18.20.8"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.18",
            "onFail": "error"
        }
    },
    "files": [
        "dist/*.js",
        "dist/*.cjs",
        "dist/*.d.ts",
        "dist/*.d.cts",
        "dist/*.map",
        "dist/styles.css",
        "README.md",
        "docs/API.md",
        "docs/event-calendar/drag-rules.md",
        "docs/event-calendar/overlap-layout.md",
        "docs/event-calendar/resize-rules.md",
        "THIRD_PARTY_NOTICES.md",
        "LICENSE",
        "LICENSES"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./date-math": {
            "import": {
                "types": "./dist/date-math.d.ts",
                "default": "./dist/date-math.js"
            },
            "require": {
                "types": "./dist/date-math.d.cts",
                "default": "./dist/date-math.cjs"
            }
        },
        "./styles.css": {
            "types": "./dist/styles.css.d.ts",
            "default": "./dist/styles.css"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "pnpm build:css && vite --host 127.0.0.1 --port 1420 --open /calendar-demo.html",
        "build:css": "node scripts/build-css.mjs",
        "build": "node scripts/build.mjs",
        "demo:build": "pnpm build:css && vite build",
        "demo:preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.lib.json",
        "test": "vitest run",
        "test:dst": "node scripts/test-dst.mjs",
        "test:browser": "pnpm demo:build && playwright test --fail-on-flaky-tests",
        "docs:screenshots": "pnpm demo:build && node scripts/capture-screenshots.mjs",
        "test:package": "pnpm build && node scripts/package-smoke.mjs",
        "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:dst && pnpm build",
        "verify": "pnpm check && pnpm test:browser && pnpm test:package",
        "prepack": "pnpm build"
    },
    "peerDependencies": {
        "@types/react": "^18.3.0 || ^19.0.0",
        "react": "^18.3.1 || ^19.0.0",
        "react-dom": "^18.3.1 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        }
    },
    "dependencies": {
        "@base-ui/react": "^1.6.0",
        "@dnd-kit/collision": "0.5.0",
        "@dnd-kit/dom": "0.5.0",
        "@dnd-kit/react": "0.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "i18next": "26.4.2",
        "lucide-react": "^1.24.0",
        "react-day-picker": "^10.0.2",
        "react-i18next": "17.0.16",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "0.18.5",
        "@eslint/js": "9.39.5",
        "@fontsource-variable/inter": "5.2.8",
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "24.13.3",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.3",
        "esbuild": "0.28.1",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "6.1.1",
        "globals": "16.5.0",
        "jsdom": "29.1.1",
        "postcss": "8.5.8",
        "postcss-selector-parser": "7.1.0",
        "prettier": "3.9.9",
        "publint": "0.3.25",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "rollup": "4.62.2",
        "rollup-plugin-dts": "6.5.1",
        "shadcn": "4.13.0",
        "sonner": "2.0.7",
        "tailwindcss": "4.3.2",
        "tw-animate-css": "1.4.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.64.0",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    }
}
